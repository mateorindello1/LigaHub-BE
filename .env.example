# Copiar este archivo como .env y completar los valores.

# Puerto de la API
PORT=3000

# Orígenes que pueden llamar a la API desde el navegador (separados por coma).
# En desarrollo, el frontend con Vite corre en http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# Cadena de conexión a SQL Server (la usan las migraciones de Prisma y la aplicación).
# Formato: sqlserver://HOST:PUERTO;database=NOMBRE;user=USUARIO;password={CONTRASEÑA};encrypt=true;trustServerCertificate=...
# Las llaves en la contraseña permiten que tenga ";" o "=".
#
# Base del proyecto, en Azure SQL Database:
#   sqlserver://ligahub.database.windows.net:1433;database=ligahub;user=ligahub_app;password={...};encrypt=true;trustServerCertificate=false;connectTimeout=60000
#   connectTimeout está en milisegundos: la base se pausa sola y tarda en reactivarse.
#
# Alternativa en SQL Server local (certificado autofirmado, por eso trustServerCertificate=true):
#   sqlserver://localhost:1433;database=LigaHub;user=ligahub_app;password={...};encrypt=true;trustServerCertificate=true
DATABASE_URL=
