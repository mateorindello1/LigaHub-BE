# Copiar este archivo como .env y completar los valores.

# Puerto de la API
PORT=3000

# Orígenes que pueden llamar a la API desde el navegador (separados por coma).
# En desarrollo, el frontend con Vite corre en http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# Cadena de conexión a SQL Server (la usan las migraciones de Prisma y la aplicación).
# Formato: sqlserver://HOST:PUERTO;database=NOMBRE;user=USUARIO;password={CONTRASEÑA};encrypt=true;trustServerCertificate=...
# Las llaves en la contraseña permiten que tenga ";" o "=".
#
# Base del proyecto, en Azure SQL Database:
#   sqlserver://ligahub.database.windows.net:1433;database=ligahub;user=ligahub_app;password={...};encrypt=true;trustServerCertificate=false;connectTimeout=60000
#   connectTimeout está en milisegundos: la base se pausa sola y tarda en reactivarse.
#
# Alternativa en SQL Server local (certificado autofirmado, por eso trustServerCertificate=true):
#   sqlserver://localhost:1433;database=LigaHub;user=ligahub_app;password={...};encrypt=true;trustServerCertificate=true
DATABASE_URL=

# Secreto con el que se firman los tokens de sesión (JWT). Al menos 32 caracteres aleatorios.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración del token de acceso (JWT): un número y la unidad (s, m, h o d). Por defecto, 15m.
# Es corta a propósito: el frontend lo renueva solo con el token de refresco.
JWT_DURACION=15m

# Duración máxima de la sesión (token de refresco, en una cookie httpOnly). Por defecto, 7d.
# Refrescar no la alarga: después de este tiempo hay que volver a iniciar sesión.
REFRESCO_DURACION=7d

# SameSite de la cookie del token de refresco: strict (por defecto), lax o none.
# strict alcanza si el frontend y la API están en el mismo sitio (localhost:5173 y localhost:3000).
# Si se publican en dominios distintos hace falta none (ver docs/seguridad.md).
COOKIE_SAMESITE=strict

# Contraseña de los usuarios de prueba que crea pnpm db:seed (al menos 12 caracteres).
# Usuarios: administrador@ligahub.test, asistente@ligahub.test y jugador@ligahub.test.
SEED_CONTRASENIA=
