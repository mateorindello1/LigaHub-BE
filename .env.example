# Copiar este archivo como .env y completar los valores.

# Puerto de la API
PORT=3000

# Cadena de conexión a SQL Server (la usan las migraciones de Prisma y la aplicación).
# Formato: sqlserver://HOST:PUERTO;database=NOMBRE;user=USUARIO;password=CONTRASEÑA;encrypt=true;trustServerCertificate=true
# Ejemplo en desarrollo local: sqlserver://localhost:1433;database=LigaHub;user=ligahub_app;password=...;encrypt=true;trustServerCertificate=true
# trustServerCertificate=true solo en local, porque el certificado de SQL Server es autofirmado.
DATABASE_URL=
